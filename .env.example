# Copy to .env.local for local conference demo execution.
# In Google Cloud Run production, mount secrets via Google Secret Manager (--set-secrets)
# and run under a dedicated least-privilege service account.
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Minimum 32-character secret for HKDF-SHA256 session & BYOK cookie derivation.
# Supports comma-separated rotation (`new_secret_32chars_min,old_secret_32chars_min`).
DECISIONS_DEMO_SESSION_SECRET=replace_with_32_plus_char_cryptographic_secret_value

# Optional explicit HTTPS origin lock on Cloud Run:
# DECISIONS_ALLOWED_ORIGIN=https://gemini-decisions-studio-1085727639300.us-central1.run.app
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

DECISIONS_DEMO_HOST=127.0.0.1
DECISIONS_DEMO_PORT=8090
